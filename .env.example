# Copy this file to .env and adjust the values as needed.
LIBRARY_API_BASE_URL=https://openlibrary.org
LIBRARY_USER_AGENT=OpenLibraryCatalogAutomation/1.0 (your-email@example.com)
LIBRARY_REQUEST_TIMEOUT=15
LIBRARY_MAX_RETRIES=3
LIBRARY_BACKOFF_FACTOR=0.5
LIBRARY_MAX_CONCURRENCY=5
LIBRARY_PAGE_SIZE=20
LIBRARY_DB_PATH=data/library.db
LIBRARY_CACHE_TTL_HOURS=24
LIBRARY_OUTPUT_DIR=data/outputs
LIBRARY_LOG_DIR=logs
LIBRARY_LOG_LEVEL=INFO
